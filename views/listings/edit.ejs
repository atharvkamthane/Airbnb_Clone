<% layout("/layouts/boilerplate") -%>

<body>
     <div class="row offset-2">
        <div class="col-8">
    
    <form method="post" action="/listings/<%= listing._id %>?_method=PUT">
        <h2 class="mt-3 headings">Edit this listing</h2>
        <div class="mb-3">
            <label for="image" class="form-label">Image</label>
            <input name="listing[title]" value="<%= listing.title %>" class="form-control">
        </div>


        <div class="mb-3">
            <label for="description" class="form-label">description</label>

            <textarea name="listing[description]" value="" class="form-control" rows="3"><%= listing.description %></textarea>
        </div>
        <div class="row">
        <div class="mb-3 col-md-6">
            <label for="price" class="form-label">price</label>
            <input name="listing[price]" value="<%= listing.price %>" class="form-control">
        </div>

        <div class="mb-3 col-md-6">
            <label for="Location" class="form-label">Location</label>
            <input name="listing[location]" value="<%= listing.location %>" class="form-control">
        </div>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Image</label>
            <input name="listing[image][url]" value="<%= listing.image.url %>" class="form-control">
        </div>
        <div class="mb-3">
            <label for="country" class="form-label">country</label>
            <input name="listing[country]" value="<%= listing.country %>" class="form-control">
        </div>
        <br>
        <button class="btn btn-dark add-btn">Edit</button>
        <br><br>


    </form>

    <div><div>

</body>
