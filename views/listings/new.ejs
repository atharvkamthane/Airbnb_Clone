<% layout("/layouts/boilerplate") -%>

<body>
    
    <div class="row offset-2">
        <div class="col-8">
            <h2 class="mt-2 headings"create a new listing>Add New Listing</h2>
    <form method="post" action="/listings">
        <div class="mb-3"><label for="title" class="form-label">Title</label>
            <input name="listing[title]" placeholder="Enter property title" class="form-control">
        </div>
        
        <div class="mb-3">
            <label for="description" class="form-label">description</label>
            <textarea name="listing[description]"  class="form-control" rows="3" >description here</textarea>
        </div>
        <div class="row">
        <div class="mb-3 col-md-6">
            <label for="price" class="form-label">price</label>
            <input name="listing[price]" placeholder="Enter price here" class="form-control">
        </div>
        
        <div class="mb-3 col-md-6">
            <label for="Location" class="form-label">Location</label>
            <input name="listing[location]" placeholder="enter property Location" class="form-control">
        </div>
        </div>
        
        <div class="mb-3">
            <label for="image" class="form-label">Image</label>
            <input name="listing[image]" placeholder="enter property imgages/URL" class="form-control">
        </div>
        
        <div class="mb-3">
            <label for="country" class="form-label">country</label>
            <input name="listing[country]" placeholder="enter property country" class="form-control">
        </div>
        <br>
       
        <button class="btn btn-dark add-btn">Add</button>
        <br><br>


    </form>

    </div>
    </div>


</body>
