    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-2 ">

        <% for(listing of allListings){ %>

    <div class="card col" style="width: 18rem;">
        <img src="<%=listing.image%>" class="card-img-top" alt="...">
        <div class="card-body">
            <p class="card-text"><%=listing.title%> <br>
            &#8377;<%= listing.price.toLocaleString('en-IN') %></p>
        </div>
    </div>
    <%}%>

    </div>
    
