<% layout("/layouts/boilerplate") -%>

<body>
    <div class="row mt-4">
        <div class="col-12 col-md-8 col-lg-6 mx-auto">
            <h3 class="fw-bold mb-3"><%= listing.title %></h3>

            <div class="card   show-card">


                <img src="<%=listing.image.url%>" class="card-img-top show-image mb-3" alt="<%= listing.title %>">
                <div class="card-body">

                    <p class="card-text text-secondary mb-3"><%= listing.description %></p>

                    <p class="fs-5 mb-1 fw-semibold">
                        &#8377;<%= listing.price.toLocaleString('en-IN') %>
                    </p>

                    <p><i class="fa-solid fa-map-location-dot"></i>
                        <%= listing.location %>,<%= listing.country %></p>



                    <!-- <a href="#" class="btn btn-primary">Go somewhere</a> -->
                </div>

            </div>

            <!-- <ul>
        <li><%= listing.title %></li>
        <li><%= listing.description %></li>
        <li>&#8377;<%= listing.price.toLocaleString('en-IN') %></li>
        <li><%= listing.location %></li>
        <li><%= listing.image %></li>
    </ul> -->



    <div class="d-flex gap-2 mb-4"> 
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger px-4 add-btn">Edit</a>
        <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark px-4">Delete</button>
        </form>
    </div>

        </div>
    </div>
    


</body>
